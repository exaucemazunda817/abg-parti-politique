generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : l'URL de connexion ne se déclare plus ici mais dans prisma.config.ts
// (pour les commandes migrate/db push) et via un adapter passé au PrismaClient
// (pour l'exécution) — voir lib/db.ts.
datasource db {
  provider = "sqlite"
}

// Statuts possibles : "PENDING" (en attente), "VALIDATED" (validé, carte
// officielle à récupérer au secrétariat), "REJECTED" (rejeté).
model Member {
  id          String   @id @default(cuid())
  accessToken String   @unique @default(cuid())
  status      String   @default("PENDING")

  membershipNo String? @unique

  nom           String
  postNom       String
  prenom        String
  sexe          String
  dateNaissance DateTime
  lieuNaissance String
  etatCivil     String?
  profession    String?

  province String
  ville    String
  commune  String?
  avenue   String?

  telephone String
  email     String?

  pieceIdentiteType   String?
  pieceIdentiteNumero String?

  photoPath String

  section String?

  createdAt      DateTime  @default(now())
  validatedAt    DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  @@index([status])
}

// Messages envoyés au parti depuis le site public, routés vers l'espace
// d'une autorité selon leur type :
// - "MESSAGE" (message général) et "DOLEANCE" (doléance/suggestion) -> Secrétariat
// - "PROPOSITION" (projet ou partenariat) -> Président
// La correspondance type -> targetRole est décidée côté serveur (jamais par le
// client) dans app/api/submissions/route.ts.
model Submission {
  id         String @id @default(cuid())
  type       String
  targetRole String

  // "Doléance" vs "Suggestion" (uniquement pour type = "DOLEANCE")
  sousType String?

  nom          String?
  email        String?
  telephone    String?
  organisation String?

  sujet   String
  message String

  status    String    @default("NOUVEAU")
  createdAt DateTime  @default(now())
  readAt    DateTime?
  treatedAt DateTime?

  @@index([targetRole, status])
}
