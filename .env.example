DATABASE_URL="file:./dev.db"
SECRETARIAT_PASSWORD="change-me"
PRESIDENT_PASSWORD="change-me-too"
SESSION_SECRET="generate-a-random-64-char-hex-string"

# Un mot de passe par Secrétaire National, dans l'ordre du tableau
# `secretairesNationaux` de lib/content.ts (1 = premier de la liste, etc.)
SECRETARY_PASSWORD_1="change-me"
SECRETARY_PASSWORD_2="change-me"
SECRETARY_PASSWORD_3="change-me"
SECRETARY_PASSWORD_4="change-me"
SECRETARY_PASSWORD_5="change-me"
SECRETARY_PASSWORD_6="change-me"
SECRETARY_PASSWORD_7="change-me"

# Notifications par e-mail (Resend, https://resend.com — compte gratuit).
# Tant que ces deux variables sont absentes, l'envoi est silencieusement ignoré
# (voir lib/email.ts) : valider/rejeter une adhésion ou traiter un message
# fonctionne quand même, seul l'e-mail au demandeur n'est pas envoyé.
# EMAIL_FROM nécessite un nom de domaine vérifié dans Resend (pas encore le cas
# pour ABG au 05/09/2026 — voir "Reste à faire" dans CLAUDE.md).
RESEND_API_KEY=""
EMAIL_FROM="ABG <notifications@abg-rdc.cd>"
